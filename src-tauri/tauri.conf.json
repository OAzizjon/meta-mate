{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaMate",
  "version": "0.2.0",
  "identifier": "app.metamate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MetaMate",
    "copyright": "MetaMate, 2026",
    "category": "Utility",
    "shortDescription": "Mate lights the button. You click it.",
    "longDescription": "A Windows helper for people who get lost on a computer: ask out loud and Mate shows the right button.",
    "homepage": "https://meta-mate.stream",
    "resources": {
      "../assets/phrases/manifest.json": "phrases/manifest.json",
      "../assets/phrases/en/": "phrases/en/",
      "../assets/phrases/ru/": "phrases/ru/",
      "../assets/phrases/NOTICE.md": "phrases/NOTICE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
